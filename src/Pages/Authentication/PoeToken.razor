@page "/poe/token"
@using System.Text.Json
@using XiletradeAuth.Models
@using XiletradeAuth.Services

@inject PoeService PoeService
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "code")]
    public string Code { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "state")]
    public string State { get; set; }

    private string ErrorMessage { get; set; }

    private string Test { get; set; }
    private string TestTwo { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        try
        {         

            var secret = await JsRuntime.InvokeAsync<string>("localStorage.getItem", Poe.Verysecret);
            Test = secret;
            if (!string.IsNullOrEmpty(secret))
            {
                await JsRuntime.InvokeVoidAsync("localStorage.removeItem", Poe.Verysecret);
                var resultSecret = await PoeService.GetPoeTokenAsync(secret);
                NavigationManager.NavigateTo($"Xiletrade://oauth?access_token={resultSecret.Token}&expires_in={resultSecret.Expires}");
                return;
            }

            var codeVerifier = await JsRuntime.InvokeAsync<string>("localStorage.getItem", Poe.StorageVerifier);
            TestTwo = codeVerifier;
            if (!Guid.TryParse(codeVerifier, out Guid parsedGuid))
            {
                throw new Exception("BADCODE");
            }
            var result = await PoeService.GetPoeTokenAsync(Code, codeVerifier);
            await JsRuntime.InvokeVoidAsync("localStorage.removeItem", Poe.StorageVerifier);
            //temp
            //Console.WriteLine($"Token: {result.Token}");
            NavigationManager.NavigateTo($"Xiletrade://oauth?access_token={result.Token}&expires_in={result.Expires}");
        }
        catch (Exception e)
        {
            ErrorMessage = e.Message + (e.InnerException?.Message?.Length > 0 
            ? ("<br />" + e.InnerException.Message) : string.Empty);
        }
    }
}

<h1>Poe Token recovery</h1>
<br />
<h3>processing request</h3>
<br />
<p>Test1: @Test</p>
<p>Test2: @TestTwo</p>
@if (ErrorMessage.Length > 0)
{
    <p>Error message : @ErrorMessage</p>
}
else
{
    <p>Path of Exile authentication ... You will be prompted to launch Xiletrade shortly.</p>
}